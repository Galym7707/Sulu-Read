<?xml version="1.0" encoding="utf-8"?>
<!--
  The three languages the app offers. Declaring them lets Android list the app in the system
  per-app language picker, and tells Play which locales must ship with the app rather than
  being inferred from the device.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="kk" />
    <locale android:name="ru" />
    <locale android:name="en" />
</locale-config>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Незашифрованный HTTP разрешён только в debug: он нужен локальному бэкенду на
         10.0.2.2 и 192.168.x.x. В релизе его нет, поэтому приложение может ходить
         только по HTTPS. -->
    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="31" />
</manifest>
